{
  "$description": "Única fuente de la marca de Pragma en el hub. De aquí salen src/styles/tokens.css (pnpm tokens), el chequeo de contraste (pnpm check:contrast) y la skill pragma-brand. No pongas colores directamente en el CSS: agrégalos aquí.",
  "brand": {
    "purple": { "value": "#6429CD", "name": "Pragma Purple", "role": "primary" },
    "deep-violet": { "value": "#531DBC", "name": "Deep Violet", "role": "primary" },
    "midnight": { "value": "#330072", "name": "Midnight", "role": "primary" },
    "lavender": { "value": "#E4A4FF", "name": "Lavender", "role": "primary" },
    "black": { "value": "#1D1D1B", "name": "Pragma Black", "role": "primary" },
    "white": { "value": "#FFFFFF", "name": "White", "role": "primary" },
    "electric": { "value": "#9610FF", "name": "Electric Violet", "role": "secondary" },
    "plum": { "value": "#7500A0", "name": "Plum", "role": "secondary" },
    "orchid": { "value": "#DD52DD", "name": "Orchid", "role": "secondary" },
    "periwinkle": { "value": "#B6B6FF", "name": "Periwinkle", "role": "secondary" },
    "ice-blue": { "value": "#D7E2FF", "name": "Ice Blue", "role": "secondary" }
  },
  "neutral": {
    "50": "#F7F6FA",
    "100": "#EDEBF2",
    "300": "#C9C6D1",
    "500": "#8E8A99",
    "600": "#5C5966",
    "700": "#3A3840",
    "800": "#28272B",
    "900": "#1D1D1B"
  },
  "font": {
    "family": "'Poppins'",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "themes": {
    "dark": {
      "--sl-color-white": "brand.white",
      "--sl-color-gray-1": "neutral.100",
      "--sl-color-gray-2": "neutral.300",
      "--sl-color-gray-3": "neutral.500",
      "--sl-color-gray-4": "neutral.600",
      "--sl-color-gray-5": "neutral.700",
      "--sl-color-gray-6": "neutral.800",
      "--sl-color-black": "neutral.900",
      "--sl-color-accent-low": "brand.midnight",
      "--sl-color-accent": "brand.electric",
      "--sl-color-accent-high": "brand.lavender"
    },
    "light": {
      "--sl-color-white": "neutral.900",
      "--sl-color-gray-1": "neutral.800",
      "--sl-color-gray-2": "neutral.700",
      "--sl-color-gray-3": "neutral.600",
      "--sl-color-gray-4": "neutral.500",
      "--sl-color-gray-5": "neutral.300",
      "--sl-color-gray-6": "neutral.100",
      "--sl-color-gray-7": "neutral.50",
      "--sl-color-black": "brand.white",
      "--sl-color-accent-low": "brand.ice-blue",
      "--sl-color-accent": "brand.purple",
      "--sl-color-accent-high": "brand.midnight"
    }
  },
  "contrast": {
    "$description": "Pares texto/fondo que se verifican en cada modo, con nombres de variables de Starlight. min 4.5 = texto normal (WCAG AA), 3 = texto grande o bordes.",
    "pairs": [
      { "fg": "--sl-color-gray-2", "bg": "--sl-color-black", "min": 4.5, "use": "texto del cuerpo" },
      { "fg": "--sl-color-white", "bg": "--sl-color-black", "min": 4.5, "use": "títulos" },
      { "fg": "--sl-color-gray-3", "bg": "--sl-color-black", "min": 4.5, "use": "texto secundario (footer, editar página)" },
      { "fg": "text-accent", "bg": "--sl-color-black", "min": 4.5, "use": "enlaces" },
      { "fg": "text-accent", "bg": "bg-nav", "min": 4.5, "use": "enlaces en la barra superior" },
      { "fg": "--sl-color-gray-2", "bg": "bg-nav", "min": 4.5, "use": "texto en la barra superior y la barra lateral" },
      { "fg": "text-invert", "bg": "text-accent", "min": 4.5, "use": "ítem activo de la barra lateral" },
      { "fg": "text-invert", "bg": "bg-accent", "min": 4.5, "use": "botón primario" },
      { "fg": "--sl-color-gray-2", "bg": "bg-inline-code", "min": 4.5, "use": "código en línea" },
      { "fg": "--sl-color-white", "bg": "--sl-color-accent-low", "min": 4.5, "use": "texto sobre fondo de acento suave" },
      { "fg": "--sl-color-accent", "bg": "--sl-color-black", "min": 3, "use": "bordes y foco" }
    ]
  }
}
