---
// Secciones de la página inicial, debajo del Hero. Se usa desde index.mdx de cada idioma.
// 1. Qué vas a encontrar: los tipos, con ejemplos y su número de fichas.
// 2. Cómo usar el hub: buscar, revisar la ficha, usarlo.
// 3. La invitación a aportar.
import { KINDS } from '../../content/taxonomy.mjs';
import type { Lang } from '../../i18n/catalog';
import { getVisibleArtifacts, sitePath } from '../../lib/artifacts';
import { home } from './copy';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const artifacts = await getVisibleArtifacts();

const kinds = (Object.keys(KINDS) as (keyof typeof t.kinds.examples)[]).map((kind) => ({
	kind,
	group: KINDS[kind].group[lang],
	how: KINDS[kind].how[lang],
	example: t.kinds.examples[kind],
	count: artifacts.filter((a) => a.data.kind === kind).length,
}));
---

<div class="ph-sections not-content" data-lang={lang}>
	<section class="ph-kinds" aria-labelledby="ph-kinds-h">
		<div class="ph-head">
			<h2 id="ph-kinds-h">{t.kinds.heading}</h2>
			<p>{t.kinds.lead}</p>
		</div>
		<ul class="ph-kinds__grid" role="list">
			{kinds.map((k) => {
				const body = (
					<>
						<span class="ph-kind__group">{k.group}</span>
						<span class="ph-kind__how">{k.how}</span>
						<span class="ph-kind__example">{k.example}</span>
						<span class="ph-kind__count">{k.count > 0 ? `${t.kinds.count(k.count)} →` : t.kinds.soon}</span>
					</>
				);
				return (
					<li>
						{k.count > 0 ? (
							<a class="ph-kind" href={sitePath(lang, `types/${k.kind}/`)}>
								{body}
							</a>
						) : (
							<span class="ph-kind is-empty">{body}</span>
						)}
					</li>
				);
			})}
		</ul>
	</section>

	<section class="ph-steps" aria-labelledby="ph-steps-h">
		<div class="ph-head">
			<h2 id="ph-steps-h">{t.steps.heading}</h2>
		</div>
		<ol class="ph-steps__list" role="list">
			{t.steps.items.map((step, i) => (
				<li>
					<span class="ph-step__n" aria-hidden="true">
						{i + 1}
					</span>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="ph-join" aria-labelledby="ph-join-h">
		<div>
			<h2 id="ph-join-h">{t.join.heading}</h2>
			<p>{t.join.text}</p>
		</div>
		<a class="ph-btn ph-btn--paper" href={sitePath(lang, 'contribute/')}>
			{t.join.action}
		</a>
	</section>
</div>
