---
// Página de un tipo: sus artefactos agrupados por disciplina principal, en el mismo orden que la barra lateral.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ArtifactCard from './ArtifactCard.astro';
import { DISCIPLINES, KINDS } from '../content/taxonomy.mjs';
import { ui, type Lang } from '../i18n/catalog';
import { sitePath, type ArtifactEntry } from '../lib/artifacts';

interface Props {
	lang: Lang;
	kind: string;
	entries: ArtifactEntry[];
}

const { lang, kind, entries } = Astro.props;
const t = ui[lang];
const groups = Object.entries(DISCIPLINES)
	.map(([discipline, label]) => ({ label: label[lang], items: entries.filter((e) => e.data.disciplines[0] === discipline) }))
	.filter((g) => g.items.length > 0);
---

<StarlightPage frontmatter={{ title: KINDS[kind].group[lang], description: KINDS[kind].how[lang], tableOfContents: false }}>
	<p>
		<strong>{KINDS[kind].how[lang]}.</strong>
		{t.typeIntro} <a href={sitePath(lang, 'catalog/')}>{t.catalogLink}</a>.
	</p>
	{
		groups.map((group) => (
			<section>
				<h2>{group.label}</h2>
				<ul class="grid not-content">
					{group.items.map((entry) => (
						<li>
							<ArtifactCard lang={lang} entry={entry} />
						</li>
					))}
				</ul>
			</section>
		))
	}
</StarlightPage>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 1rem;
		padding: 0;
		list-style: none;
	}
</style>
