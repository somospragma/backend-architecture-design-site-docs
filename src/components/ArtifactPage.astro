---
// Página de detalle de una ficha. La usan src/pages/catalog/[slug].astro y su versión en inglés.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside, Badge, LinkButton } from '@astrojs/starlight/components';
import { areaLabels, kindLabels, originLabels, statusLabels, statusVariant, ui, type Lang } from '../i18n/catalog';
import { artifactPath, docsHref, ownerHref, registryHref, sitePath, type ArtifactEntry } from '../lib/artifacts';

interface Props {
	lang: Lang;
	entry: ArtifactEntry;
}

const { lang, entry } = Astro.props;
const { id, data } = entry;
const t = ui[lang];
const registryLink = data.registry && registryHref(data.registry);
const replacedByHref = data.replacedBy?.startsWith('https://') ? data.replacedBy : data.replacedBy && artifactPath(lang, data.replacedBy);
const reviewed = data.lastReviewed.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<StarlightPage frontmatter={{ title: data.name, description: data.summary[lang] }}>
	<p class="lead">{data.summary[lang]}</p>

	<p class="badges">
		<Badge text={statusLabels[lang][data.status]} variant={statusVariant[data.status]} />
		<Badge text={kindLabels[lang][data.kind]} />
		<Badge text={originLabels[lang][data.origin]} variant={data.origin === 'official' ? 'tip' : 'default'} />
		{data.draft && <Badge text={t.draft} variant="caution" />}
	</p>

	{
		data.status === 'deprecated' && (
			<Aside type="danger" title={t.deprecatedTitle}>
				{data.deprecationNote && <p>{data.deprecationNote[lang]}</p>}
				{replacedByHref && (
					<p>
						{t.replacedBy} <a href={replacedByHref}>{data.replacedBy}</a>
					</p>
				)}
			</Aside>
		)
	}

	{data.description && <p>{data.description[lang]}</p>}

	<LinkButton href={docsHref(lang, id, data)} icon="right-arrow">
		{data.docs.mode === 'hosted' ? t.docsHosted : t.docsIndexed}
	</LinkButton>

	<table>
		<tbody>
			<tr><th scope="row">{t.fieldArea}</th><td><a href={sitePath(lang, `areas/${data.area}/`)}>{areaLabels[lang][data.area]}</a></td></tr>
			<tr><th scope="row">{t.fieldKind}</th><td>{kindLabels[lang][data.kind]}</td></tr>
			<tr><th scope="row">{t.fieldEcosystems}</th><td>{data.ecosystems.join(', ')}</td></tr>
			<tr><th scope="row">{t.fieldOrigin}</th><td>{originLabels[lang][data.origin]}</td></tr>
			<tr>
				<th scope="row">{t.fieldOwners}</th>
				<td>{data.owners.map((o, i) => <>{i > 0 && ', '}<a href={ownerHref(o)}>{o}</a></>)}</td>
			</tr>
			<tr><th scope="row">{t.fieldRepository}</th><td><a href={data.repository}>{data.repository.replace('https://', '')}</a></td></tr>
			{
				data.registry && (
					<tr>
						<th scope="row">{t.fieldRegistry}</th>
						<td>{registryLink ? <a href={registryLink}><code>{data.registry.id}</code></a> : <code>{data.registry.id}</code>} ({data.registry.type})</td>
					</tr>
				)
			}
			<tr><th scope="row">{t.fieldLicense}</th><td><code>{data.license}</code></td></tr>
			{data.tags.length > 0 && <tr><th scope="row">{t.fieldTags}</th><td>{data.tags.join(', ')}</td></tr>}
			<tr><th scope="row">{t.fieldLastReviewed}</th><td>{reviewed}</td></tr>
		</tbody>
	</table>

	<p><a href={sitePath(lang, 'catalog/')}>← {t.backToCatalog}</a></p>
</StarlightPage>

<style>
	.lead {
		font-size: var(--sl-text-lg);
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}
</style>
